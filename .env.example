# HireLens — Environment Variables
# Copy to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── App ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Groq (Primary high-speed LLM) ───────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Gemini (Secondary / Backup LLM) ─────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Razorpay ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Supabase (server-only) ───────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Business config & Packages ────────────────────
SCAN_PRICE_INR=19
BUNDLE_PRICE_INR=39
FREE_SCAN_PROMO_ENABLED=true
FREE_SCAN_PROMO_START_AT=
FREE_SCAN_PROMO_DURATION_HOURS=48
SCAN_DRAFT_TTL_MINUTES=45
REPORT_RETENTION_DAYS=7


# ── Rate limiting (server-only) ──────────────────
RATE_LIMIT_DRAFT_PER_MINUTE=5
RATE_LIMIT_ANALYZE_PER_MINUTE=3
